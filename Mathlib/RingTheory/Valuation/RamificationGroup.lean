public import Mathlib.RingTheory.Valuation.ValuationSubring

/-!
# Ramification groups

The decomposition subgroup and inertia subgroups.

The higher ramification groups in the lower numbering are `Ideal.ramificationGroup`. We show
that the inertia subgroup of a valuation subring is the ramification group `G_0` of its maximal
ideal (`ValuationSubring.inertiaSubgroup_eq_ramificationGroup_zero`), and that over a discrete
valuation ring with a single generator `x`, `σ ∈ G_i` if and only if `v(σ x - x) ≥ i + 1`
(`IsDiscreteValuationRing.mem_ramificationGroup_iff_le_addVal`, see [serre1968], Chapter IV, §1).

## Provenance

`ValuationSubring.inertiaSubgroup_eq_ramificationGroup_zero` and
`IsDiscreteValuationRing.mem_ramificationGroup_iff_le_addVal` are adapted from the Tau Ceti library
(https://github.com/TauCetiProject/TauCeti, commit `396c3bd971e9722aa8656231760e710fe641d8cf`,
file `TauCeti/RingTheory/LocalRing/RamificationGroup.lean`; Copyright (c) 2026 The Tau Ceti
contributors; released under the Apache 2.0 license), restated for `Ideal.ramificationGroup` and
with new proofs.
-/

@[expose] public section


namespace ValuationSubring

open scoped Pointwise

variable (K : Type*) {L : Type*} [Field K] [Field L] [Algebra K L]

/-- The decomposition subgroup defined as the stabilizer of the action
on the type of all valuation subrings of the field. -/
abbrev decompositionSubgroup (A : ValuationSubring L) : Subgroup (L ≃ₐ[K] L) :=
  MulAction.stabilizer (L ≃ₐ[K] L) A

/-- The valuation subring `A` (considered as a subset of `L`)
is stable under the action of the decomposition group. -/
def subMulAction (A : ValuationSubring L) : SubMulAction (A.decompositionSubgroup K) L where
  carrier := A
  smul_mem' g _ h := Set.mem_of_mem_of_subset (Set.smul_mem_smul_set h) g.prop.le

/-- The multiplicative action of the decomposition subgroup on `A`. -/
instance decompositionSubgroupMulSemiringAction (A : ValuationSubring L) :
    MulSemiringAction (A.decompositionSubgroup K) A :=
  { SubMulAction.mulAction (A.subMulAction K) with
    smul_add := fun g k l => Subtype.ext <| smul_add (A := L) g k l
    smul_zero := fun g => Subtype.ext <| smul_zero g
    smul_one := fun g => Subtype.ext <| smul_one g
    smul_mul := fun g k l => Subtype.ext <| smul_mul' (N := L) g k l }

/-- The inertia subgroup defined as the kernel of the group homomorphism from
the decomposition subgroup to the group of automorphisms of the residue field of `A`. -/
noncomputable def inertiaSubgroup (A : ValuationSubring L) : Subgroup (A.decompositionSubgroup K) :=
  MonoidHom.ker <|
    MulSemiringAction.toRingAut (A.decompositionSubgroup K) (IsLocalRing.ResidueField A)

/-- The inertia subgroup of `A` is the ramification group `G_0` of the maximal ideal of `A`, for
the action of the decomposition subgroup on `A`. -/
theorem inertiaSubgroup_eq_ramificationGroup_zero (A : ValuationSubring L) :
    A.inertiaSubgroup K = (IsLocalRing.maximalIdeal A).ramificationGroup _ 0 := by
  ext σ
  rw [inertiaSubgroup, MonoidHom.mem_ker, Ideal.ramificationGroup_zero, Ideal.mem_inertia]
  refine ⟨fun h x ↦ ?_, fun h ↦ ?_⟩
  · have hx : σ • IsLocalRing.residue A x = IsLocalRing.residue A x :=
      congr($h (IsLocalRing.residue A x))
    rwa [← IsLocalRing.ResidueField.residue_smul, ← sub_eq_zero, ← map_sub,
      IsLocalRing.residue_eq_zero_iff] at hx
  · ext y
    obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
    change σ • IsLocalRing.residue A x = IsLocalRing.residue A x
    rw [← IsLocalRing.ResidueField.residue_smul, ← sub_eq_zero, ← map_sub,
      IsLocalRing.residue_eq_zero_iff]
    exact h x

end ValuationSubring

namespace IsDiscreteValuationRing

open IsLocalRing

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

/-- Let `G` act on a discrete valuation ring `R` by `A`-algebra automorphisms, where `R` is
generated by a single element `x` as an `A`-algebra. Then `σ` lies in the `i`-th ramification
group of the maximal ideal if and only if `v(σ x - x) ≥ i + 1`; this is the definition of `G_i`
in [serre1968], Chapter IV, §1. -/
theorem mem_ramificationGroup_iff_le_addVal {G : Type*} [Group G] [MulSemiringAction G R]
    {A : Type*} [CommRing A] [Algebra A R] [SMulCommClass G A R] {x : R}
    (hx : Algebra.adjoin A {x} = ⊤) {i : ℤ} {σ : G} :
    σ ∈ (maximalIdeal R).ramificationGroup G i ↔ ((i + 1).toNat : ℕ∞) ≤ addVal R (σ • x - x) := by
  rw [Ideal.mem_ramificationGroup_iff_of_adjoin_singleton_eq_top hx, mem_maximalIdeal_pow_iff]

end IsDiscreteValuationRing
