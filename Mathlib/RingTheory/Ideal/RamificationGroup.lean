module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.RingTheory.Filtration
public import Mathlib.RingTheory.Ideal.Pointwise

/-!
# Higher ramification groups in the lower numbering

Let a group `G` act by ring automorphisms on a commutative ring `B` and let `P` be an ideal of
`B`. For an integer `i`, the `i`-th ramification group (in the lower numbering) of `P` is
the subgroup of `G` of elements acting trivially on `B ⧸ P ^ (i + 1)`, i.e.
`G_i = {σ ∈ G | ∀ x : B, σ • x - x ∈ P ^ (i + 1)}`.

For a finite Galois extension `L/K` of fields that are complete with respect to a discrete
valuation, with separable residue field extension, `G = Gal(L/K)` acting on the valuation ring
`B` of `L` and `P` its maximal ideal, these are the groups `G_i` of [serre1968], Chapter IV, §1.

## Main definitions

* `Ideal.ramificationGroup G P i`: the `i`-th ramification group of `P`, for `i : ℤ`. Following
  the convention `P ^ 0 = ⊤`, the ideal `P ^ (i + 1)` is read as `P ^ (i + 1).toNat`, so that
  `G_i = G` for all `i ≤ -1`.

## Main results

* `Ideal.ramificationGroup_neg_one`, `Ideal.ramificationGroup_zero`: `G_{-1} = G`, and `G_0` is
  the inertia subgroup `Ideal.inertia G P`.
* `Ideal.ramificationGroup_antitone`: the `G_i` form a decreasing family.
* `Ideal.ramificationGroup_smul`: the ramification groups of `g • P` are the conjugates by `g` of
  those of `P`; hence each `G_i` is normal in the stabilizer of `P`
  (`Ideal.normal_ramificationGroup_of_forall_smul_eq`), in particular in `G` when `B` is local
  and `P` is its maximal ideal.
* `Ideal.mem_ramificationGroup_iff_of_adjoin_eq_top`: if `G` acts by `A`-algebra automorphisms
  and `B` is generated by a set `s` as an `A`-algebra, then membership in `G_i` can be tested on
  `s`; for a single generator `x` this is the test `σ • x - x ∈ P ^ (i + 1)` of [serre1968],
  Chapter IV, §1.
* `Ideal.exists_ramificationGroup_eq_bot`: if `G` acts faithfully, `G_0` is finite and
  `⋂ₙ P ^ n = 0` (e.g. `B` is a Noetherian local ring or domain and `P` is proper), then
  `G_i = 1` for all large `i`.

## References

* [J.-P. Serre, *Corps locaux*][serre1968], Chapter IV, §1

## Provenance

The integer indexing convention (`P ^ (i + 1)` read as `P ^ (i + 1).toNat`), the names of most
declarations and several statements and proofs are adapted from the Tau Ceti library
(https://github.com/TauCetiProject/TauCeti, commit `396c3bd971e9722aa8656231760e710fe641d8cf`,
files `TauCeti/RingTheory/Ideal/RamificationGroup.lean` and
`TauCeti/RingTheory/LocalRing/RamificationGroup.lean`; Copyright (c) 2026 The Tau Ceti
contributors; released under the Apache 2.0 license). Changes: a single definition for an
arbitrary ideal of a ring with a group action, indexed by `ℤ` (Tau Ceti has an `ℕ`-indexed
version for ideals and a `ℤ`-indexed one for local rings), different proofs of most statements,
and the corollaries for Noetherian local rings and domains stated with a finite inertia group.

## Tags

ramification group, lower numbering, inertia group
-/

@[expose] public section

open scoped Pointwise

namespace Ideal

variable (G : Type*) [Group G] {B : Type*} [CommRing B] [MulSemiringAction G B]

/-- The `i`-th ramification group (in the lower numbering) of an ideal `P` of `B`: the subgroup
of elements of `G` acting trivially on `B ⧸ P ^ (i + 1)`. For `i ≤ -1` the ideal `P ^ (i + 1)` is
read as `P ^ 0 = ⊤`, so that the ramification group is all of `G`. -/
def ramificationGroup (P : Ideal B) (i : ℤ) : Subgroup G :=
  (P ^ (i + 1).toNat).inertia G

variable {G} {P : Ideal B} {i j : ℤ} {σ : G}

theorem mem_ramificationGroup :
    σ ∈ P.ramificationGroup G i ↔ ∀ x : B, σ • x - x ∈ P ^ (i + 1).toNat :=
  Iff.rfl

theorem ramificationGroup_natCast (n : ℕ) :
    P.ramificationGroup G n = (P ^ (n + 1)).inertia G := by
  unfold ramificationGroup
  congr 2

theorem mem_ramificationGroup_natCast {n : ℕ} :
    σ ∈ P.ramificationGroup G n ↔ ∀ x : B, σ • x - x ∈ P ^ (n + 1) := by
  rw [ramificationGroup_natCast, mem_inertia]

theorem ramificationGroup_eq_top_of_le_neg_one (hi : i ≤ -1) : P.ramificationGroup G i = ⊤ := by
  have hi' : (i + 1).toNat = 0 := Int.toNat_eq_zero.mpr (by omega)
  simp only [ramificationGroup, hi', pow_zero, Ideal.one_eq_top, Ideal.inertia_top]

@[simp]
theorem ramificationGroup_neg_one : P.ramificationGroup G (-1) = ⊤ :=
  ramificationGroup_eq_top_of_le_neg_one le_rfl

@[simp]
theorem ramificationGroup_zero : P.ramificationGroup G 0 = P.inertia G := by
  simp [ramificationGroup]

theorem ramificationGroup_antitone : Antitone (P.ramificationGroup G) := by
  intro i j hij
  exact AddSubgroup.inertia_mono G (Ideal.pow_le_pow_right (by omega))

theorem ramificationGroup_le_inertia (hi : 0 ≤ i) : P.ramificationGroup G i ≤ P.inertia G := by
  rw [← ramificationGroup_zero (P := P)]
  exact ramificationGroup_antitone hi

theorem ramificationGroup_le_stabilizer (hi : 0 ≤ i) :
    P.ramificationGroup G i ≤ MulAction.stabilizer G P :=
  (ramificationGroup_le_inertia hi).trans (Ideal.inertia_le_stabilizer P)

/-- The ramification groups are monotone in the ideal. -/
theorem ramificationGroup_mono {Q : Ideal B} (h : P ≤ Q) (i : ℤ) :
    P.ramificationGroup G i ≤ Q.ramificationGroup G i :=
  AddSubgroup.inertia_mono G (Ideal.pow_right_mono h _)

@[simp]
theorem subgroupOf_ramificationGroup (H : Subgroup G) (i : ℤ) :
    (P.ramificationGroup G i).subgroupOf H = P.ramificationGroup H i :=
  rfl

/-- The ramification groups of `g • P` are the conjugates by `g` of those of `P`. -/
theorem ramificationGroup_smul (g : G) (P : Ideal B) (i : ℤ) :
    (g • P).ramificationGroup G i = (P.ramificationGroup G i).map (MulAut.conj g) := by
  simp only [ramificationGroup, ← smul_pow', inertia_smul]

/-- If every element of `G` fixes `P`, then the ramification groups of `P` are normal in `G`. -/
theorem normal_ramificationGroup_of_forall_smul_eq (h : ∀ g : G, g • P = P) (i : ℤ) :
    (P.ramificationGroup G i).Normal := by
  rw [Subgroup.normal_iff_map_conj_eq]
  intro g
  rw [← ramificationGroup_smul, h g]

/-- The ramification groups of `P` are normal in the stabilizer (decomposition group) of `P`. -/
instance (P : Ideal B) (i : ℤ) :
    (P.ramificationGroup (MulAction.stabilizer G P) i).Normal := by
  simp_rw [Subgroup.normal_iff_map_conj_eq, ← ramificationGroup_smul]
  exact fun g ↦ congrArg (ramificationGroup _ · i) g.2

/-- If `G` acts by `A`-algebra automorphisms and `B` is generated by `s` as an `A`-algebra, then
`σ` acts trivially modulo an ideal `I` as soon as it does so on `s`. -/
theorem mem_inertia_iff_of_adjoin_eq_top {A : Type*} [CommRing A] [Algebra A B]
    [SMulCommClass G A B] (I : Ideal B) {s : Set B} (hs : Algebra.adjoin A s = ⊤) :
    σ ∈ I.inertia G ↔ ∀ x ∈ s, σ • x - x ∈ I := by
  refine ⟨fun h x _ ↦ h x, fun h ↦ ?_⟩
  rw [Ideal.mem_inertia]
  intro x
  have hx : x ∈ Algebra.adjoin A s := hs ▸ Algebra.mem_top
  induction hx using Algebra.adjoin_induction with
  | mem x hx => exact h x hx
  | algebraMap r =>
    simp only [Algebra.algebraMap_eq_smul_one, smul_comm, smul_one, sub_self, zero_mem]
  | add x y _ _ hx hy =>
    simpa only [smul_add, add_sub_add_comm] using I.add_mem hx hy
  | mul x y _ _ hx hy =>
    rw [smul_mul', show σ • x * σ • y - x * y = (σ • x - x) * σ • y + x * (σ • y - y) by ring]
    exact I.add_mem (I.mul_mem_right _ hx) (I.mul_mem_left _ hy)

/-- If `G` acts by `A`-algebra automorphisms and `B` is generated by `s` as an `A`-algebra, then
membership in a ramification group can be tested on `s`. -/
theorem mem_ramificationGroup_iff_of_adjoin_eq_top {A : Type*} [CommRing A] [Algebra A B]
    [SMulCommClass G A B] {s : Set B} (hs : Algebra.adjoin A s = ⊤) :
    σ ∈ P.ramificationGroup G i ↔ ∀ x ∈ s, σ • x - x ∈ P ^ (i + 1).toNat :=
  mem_inertia_iff_of_adjoin_eq_top _ hs

/-- If `B` is generated by a single element `x` as an `A`-algebra, then `σ ∈ G_i` if and only if
`σ • x - x ∈ P ^ (i + 1)`, see [serre1968], Chapter IV, §1. -/
theorem mem_ramificationGroup_iff_of_adjoin_singleton_eq_top {A : Type*} [CommRing A]
    [Algebra A B] [SMulCommClass G A B] {x : B} (hx : Algebra.adjoin A {x} = ⊤) :
    σ ∈ P.ramificationGroup G i ↔ σ • x - x ∈ P ^ (i + 1).toNat := by
  rw [mem_ramificationGroup_iff_of_adjoin_eq_top hx]
  simp only [Set.mem_singleton_iff, forall_eq]

/-- If `G` acts faithfully and `⋂ₙ P ^ n = 0`, then the intersection of the ramification groups
of `P` is trivial. -/
theorem iInf_ramificationGroup_eq_bot [FaithfulSMul G B] (hP : ⨅ n : ℕ, P ^ n = ⊥) :
    ⨅ i, P.ramificationGroup G i = ⊥ := by
  rw [Subgroup.eq_bot_iff_forall]
  intro σ hσ
  apply eq_of_smul_eq_smul (α := B)
  intro x
  have hmem : ∀ n : ℕ, σ • x - x ∈ P ^ n := by
    intro n
    cases n with
    | zero => simp
    | succ n =>
        have hσn := (Subgroup.mem_iInf.mp hσ) (n : ℤ)
        simpa [ramificationGroup_natCast] using (mem_ramificationGroup.mp hσn) x
  have hx : σ • x - x ∈ ⨅ n : ℕ, P ^ n := Ideal.mem_iInf.mpr hmem
  rw [hP, Ideal.mem_bot, sub_eq_zero] at hx
  simpa only [one_smul] using hx

/-- If `G` acts faithfully, the inertia group `G_0` of `P` is finite and `⋂ₙ P ^ n = 0`, then
`G_i = 1` for all large `i`. -/
theorem exists_ramificationGroup_eq_bot [Finite (P.inertia G)] [FaithfulSMul G B]
    (hP : ⨅ n : ℕ, P ^ n = ⊥) : ∃ n : ℤ, ∀ i, n ≤ i → P.ramificationGroup G i = ⊥ := by
  have h (σ : P.inertia G) : ∃ n : ℤ, (σ : G) ≠ 1 → (σ : G) ∉ P.ramificationGroup G n := by
    by_cases hσ : (σ : G) = 1
    · exact ⟨0, fun h ↦ (h hσ).elim⟩
    · have hσ' : (σ : G) ∉ ⨅ i, P.ramificationGroup G i := by
        rw [iInf_ramificationGroup_eq_bot hP, Subgroup.mem_bot]
        exact hσ
      rw [Subgroup.mem_iInf, not_forall] at hσ'
      obtain ⟨n, hn⟩ := hσ'
      exact ⟨n, fun _ ↦ hn⟩
  choose f hf using h
  obtain ⟨n, hn⟩ := (Set.finite_range f).bddAbove
  refine ⟨max n 0, fun i hi ↦ (Subgroup.eq_bot_iff_forall _).mpr fun σ hσ ↦ ?_⟩
  have hσ₀ : σ ∈ P.inertia G := ramificationGroup_le_inertia ((le_max_right _ _).trans hi) hσ
  by_contra hσ₁
  refine hf ⟨σ, hσ₀⟩ hσ₁ (ramificationGroup_antitone ?_ hσ)
  exact (hn (Set.mem_range_self _)).trans ((le_max_left _ _).trans hi)

/-- If `G` acts faithfully on a Noetherian local ring `B` with finite inertia group, then for
every proper ideal `P` we have `G_i = 1` for all large `i`. -/
theorem exists_ramificationGroup_eq_bot_of_isLocalRing [Finite (P.inertia G)]
    [FaithfulSMul G B] [IsNoetherianRing B] [IsLocalRing B] (hP : P ≠ ⊤) :
    ∃ n : ℤ, ∀ i, n ≤ i → P.ramificationGroup G i = ⊥ :=
  exists_ramificationGroup_eq_bot (Ideal.iInf_pow_eq_bot_of_isLocalRing (I := P) hP)

/-- If `G` acts faithfully on a Noetherian domain `B` with finite inertia group, then for every
proper ideal `P` we have `G_i = 1` for all large `i`. This applies to a nonzero prime of the ring
of integers of a Galois extension of number fields. -/
theorem exists_ramificationGroup_eq_bot_of_isDomain [Finite (P.inertia G)]
    [FaithfulSMul G B] [IsNoetherianRing B] [IsDomain B] (hP : P ≠ ⊤) :
    ∃ n : ℤ, ∀ i, n ≤ i → P.ramificationGroup G i = ⊥ :=
  exists_ramificationGroup_eq_bot (Ideal.iInf_pow_eq_bot_of_isDomain (I := P) hP)

end Ideal

namespace IsLocalRing

variable {G : Type*} [Group G] {B : Type*} [CommRing B] [IsLocalRing B] [MulSemiringAction G B]

/-- Ring automorphisms of a local ring fix its maximal ideal. -/
@[simp]
theorem smul_maximalIdeal (g : G) : g • maximalIdeal B = maximalIdeal B := by
  apply le_antisymm
  · exact le_maximalIdeal (Ideal.IsPrime.ne_top' (I := g • maximalIdeal B))
  · rw [Ideal.subset_pointwise_smul_iff]
    exact le_maximalIdeal (Ideal.IsPrime.ne_top' (I := g⁻¹ • maximalIdeal B))

/-- The ramification groups of the maximal ideal of a local ring are normal. -/
instance (i : ℤ) : ((maximalIdeal B).ramificationGroup G i).Normal :=
  Ideal.normal_ramificationGroup_of_forall_smul_eq (fun g ↦ smul_maximalIdeal g) i

end IsLocalRing
